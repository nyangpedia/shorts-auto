OPENAI_API_KEY=
YOUTUBE_API_KEY=
HIGGSFIELD_API_KEY=
# Free stock photos/videos for the "pexels" scene model: https://www.pexels.com/api/
PEXELS_API_KEY=
# TTS_PROVIDER=edge (free preset voices) or qwen3 (local voice cloning, needs GPU)
TTS_PROVIDER=edge
# Korean voices: ko-KR-SunHiNeural (female), ko-KR-InJoonNeural (male)
EDGE_TTS_VOICE=ko-KR-SunHiNeural
QWEN3_TTS_BASE_URL=http://127.0.0.1:7860
REFERENCE_VOICE_PATH=assets/reference_voice/reference_voice.mp3
REFERENCE_VOICE_TEXT=안녕하세요 여러분. 반갑습니다. 오늘도 저희 채널을 찾아주셔서 감사합니다. 영상이 도움되셨다면 구독과 좋아요를 눌러주세요.
BGM_PATH=assets/bgm/channel_bgm.mp3
BGM_VOLUME=0.18
OUTPUT_DIR=outputs
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
YT_DLP_BINARY=yt-dlp
REFERENCE_AUDIO_FILENAME=reference_audio.wav

# STT Settings (Speech-to-Text)
USE_FASTER_WHISPER=true
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# LLM: leave LLM_BASE_URL empty for OpenAI. For free Gemini, put the Gemini key in OPENAI_API_KEY and set:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_ANALYSIS_MODEL=gemini-2.5-flash
LLM_BASE_URL=
